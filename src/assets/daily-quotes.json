{
  "quotes": [
    { "text": "行到水穷处，坐看云起时。", "from": "王维《终南别业》", "tag": "诗词" },
    { "text": "竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。", "from": "苏轼《定风波》", "tag": "诗词" },
    { "text": "人生如逆旅，我亦是行人。", "from": "苏轼《临江仙》", "tag": "诗词" },
    { "text": "此心安处是吾乡。", "from": "苏轼《定风波》", "tag": "诗词" },
    { "text": "采菊东篱下，悠然见南山。", "from": "陶渊明《饮酒》", "tag": "诗词" },
    { "text": "海内存知己，天涯若比邻。", "from": "王勃《送杜少府之任蜀州》", "tag": "诗词" },
    { "text": "长风破浪会有时，直挂云帆济沧海。", "from": "李白《行路难》", "tag": "诗词" },
    { "text": "但愿人长久，千里共婵娟。", "from": "苏轼《水调歌头》", "tag": "诗词" },
    { "text": "明月松间照，清泉石上流。", "from": "王维《山居秋暝》", "tag": "诗词" },
    { "text": "大漠孤烟直，长河落日圆。", "from": "王维《使至塞上》", "tag": "诗词" },
    { "text": "会当凌绝顶，一览众山小。", "from": "杜甫《望岳》", "tag": "诗词" },
    { "text": "星垂平野阔，月涌大江流。", "from": "杜甫《旅夜书怀》", "tag": "诗词" },
    { "text": "莫听穿林打叶声，何妨吟啸且徐行。", "from": "苏轼《定风波》", "tag": "诗词" },
    { "text": "落霞与孤鹜齐飞，秋水共长天一色。", "from": "王勃《滕王阁序》", "tag": "古文" },
    { "text": "不以物喜，不以己悲。", "from": "范仲淹《岳阳楼记》", "tag": "古文" },
    { "text": "纸上得来终觉浅，绝知此事要躬行。", "from": "陆游《冬夜读书示子聿》", "tag": "古文" },
    { "text": "问渠那得清如许？为有源头活水来。", "from": "朱熹《观书有感》", "tag": "古文" },
    { "text": "不畏浮云遮望眼，自缘身在最高层。", "from": "王安石《登飞来峰》", "tag": "古文" },
    { "text": "沉舟侧畔千帆过，病树前头万木春。", "from": "刘禹锡《酬乐天扬州初逢席上见赠》", "tag": "古文" },
    { "text": "知者不惑，仁者不忧，勇者不惧。", "from": "《论语·子罕》", "tag": "古文" },
    { "text": "君子和而不同，小人同而不和。", "from": "《论语·子路》", "tag": "古文" },
    { "text": "宠辱不惊，看庭前花开花落；去留无意，望天上云卷云舒。", "from": "《菜根谭》", "tag": "古文" },
    { "text": "静坐常思己过，闲谈莫论人非。", "from": "《格言联璧》", "tag": "古文" },
    { "text": "山重水复疑无路，柳暗花明又一村。", "from": "陆游《游山西村》", "tag": "诗词" },
    { "text": "万物皆有裂痕，那是光照进来的地方。", "from": "莱昂纳德·科恩", "tag": "名言" },
    { "text": "我们都在阴沟里，但仍有人仰望星空。", "from": "奥斯卡·王尔德", "tag": "名言" },
    { "text": "凡是过往，皆为序章。", "from": "莎士比亚《暴风雨》", "tag": "名言" },
    { "text": "慢慢来，比较快。", "from": "佚名", "tag": "短句" },
    { "text": "把时间浪费在美好的事物上。", "from": "佚名", "tag": "短句" },
    { "text": "安静的页面，才让人愿意常回来。", "from": "自留", "tag": "短句" }
  ]
}
