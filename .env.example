# 复制为 .env（或 .env.dev）后填写。所有内容均可通过变量覆盖，无需改代码。

# --- 站点 SEO ---
VITE_SITE_NAME=fuhouyu
VITE_SITE_KEYWORDS=付后钰
VITE_SITE_DES=fuhouyu 的个人主页
VITE_SITE_AUTHOR=fuhouyu
VITE_GITHUB_USERNAME=fuhouyu
VITE_CITY=杭州
VITE_EMAIL=you@example.com

# --- 站点入口 ---
VITE_PASTE_URL=https://paste.fuhouyu.com

# --- 天气（Open-Meteo，坐标留空则用配置默认值）---
VITE_WEATHER_API=https://api.open-meteo.com/v1/forecast
VITE_WEATHER_CITY=杭州
VITE_WEATHER_LAT=30.2741
VITE_WEATHER_LON=120.1551
VITE_WEATHER_TZ=Asia/Shanghai

# --- 每日一言（留空使用 src/assets/daily-quotes.json 内置句库）---
# 可填一言接口（如 https://v1.hitokoto.cn），或返回 { "quotes": [...] } / 数组的 JSON 地址
VITE_DAILY_QUOTE_API=

# --- 头版图（报头「头版图」开关打开时拉取每日一图，满幅铺成整页背景，默认打开）---
VITE_WALLPAPER_API=https://bing.biturl.top/?resolution=1920&format=json&index=0

# --- 音乐配置 ---
# 数据源：netease 网易云音乐 / tencent QQ音乐
VITE_SONG_API=https://api.injahow.cn/meting/
# 类型：song 单曲 / playlist 歌单
VITE_SONG_TYPE=playlist
# 单曲 ID 或歌单 ID
VITE_SONG_ID=458978813
VITE_SONG_SERVER=netease

# --- 备案与合规 ---
VITE_ICP=
